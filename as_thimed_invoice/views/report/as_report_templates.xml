<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_cedible_wrapper">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.invoice_user_id.sudo().lang if o.move_type in ('in_invoice', 'in_refund') else o.partner_id.lang"/>
                <t t-if="o._get_name_invoice_report() == 'account.report_invoice_document'"
                   t-call="account.report_invoice_document" t-lang="lang"/>
                <t t-if="o._get_name_invoice_report() == 'l10n_cl.report_invoice_document'"
                   t-call="l10n_cl.report_invoice_document" t-lang="lang"/>
            </t>
        </t>
    </template>

    <template id="report_invoice_document_cedible" inherit_id="account.report_invoice_document">
        <!-- Agrega el bloque de acuse de recibo y la palabra "CEDIBLE" al final del reporte -->
        <xpath expr="//div[@id='total']" position="after">
            <div class="cedible-footer mt-4" style="page-break-inside: avoid; clear: both; width: 100%;">
                <div style="border:1px solid #ccc; font-size: 8px; padding: 5px; margin-top: 20px;">
                    Nombre: ___________________________________________ R.U.T.:
                    ________________________________________________________<br />
                    Recinto: __________________________________________ Fecha: _________________________ Firma:
                    __________________________<br />
                    "El acuse de recibo que se declara en este acto, de acuerdo a lo dispuesto en la letra b) del
                    Art. 4, y la letra c) del Art. 5 de la Ley 19.983, acredita que la entrega de mercaderias o
                    servicio(s) prestado(s) ha(n) sido recibido(s)".
                </div>
                <div style="text-align:right; font-weight: bold; font-size: 14px; margin-top: 10px;">CEDIBLE</div>
            </div>
        </xpath>
    </template>
</odoo>
