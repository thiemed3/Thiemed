<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.stock.account</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='production_lot_info']" position="after">
                    <block title="Kardex de Inventario" name="as_inventory_kardex">
                        <setting id="as_fecha_invenatario_setting" string="Inicio Movimiento de Inventario" help="Fecha de inicio para el Kardex de Productos e inventario inicial.">
                            <field name="as_fecha_invenatario"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
