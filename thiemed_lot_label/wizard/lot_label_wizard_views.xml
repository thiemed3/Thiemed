<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_thiemed_lot_label_wizard_form" model="ir.ui.view">
    <field name="name">thiemed.lot.label.wizard.form</field>
    <field name="model">thiemed.lot.label.wizard</field>
    <field name="arch" type="xml">
      <form string="Imprimir etiquetas Thiemed">
        <group>
          <field name="lot_ids" widget="many2many_tags"/>
          <field name="quantity"/>
        </group>
        <footer>
          <button name="action_print" type="object" string="Imprimir" class="btn-primary"/>
          <button string="Cancelar" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_thiemed_lot_label_wizard" model="ir.actions.act_window">
    <field name="name">Imprimir etiquetas Thiemed</field>
    <field name="res_model">thiemed.lot.label.wizard</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_thiemed_lot_label_wizard_form"/>
    <field name="target">new</field>
    <field name="binding_model_id" ref="stock.model_stock_lot"/>
    <field name="binding_view_types">list,form</field>
  </record>
</odoo>
