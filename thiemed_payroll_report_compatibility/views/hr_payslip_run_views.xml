<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_general_payroll_run_list" model="ir.ui.view">
        <field name="name">hr.payslip.run.general.payroll.list</field>
        <field name="model">hr.payslip.run</field>
        <field name="arch" type="xml">
            <list string="Nómina general" create="0" edit="0" delete="0" import="0"
                  default_order="date_start desc, id desc">
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="payslip_count"/>
                <field name="state"/>
                <button name="action_print_general_payroll" type="object"
                        string="Nómina general" icon="fa-print"
                        groups="hr_payroll.group_hr_payroll_user"/>
            </list>
        </field>
    </record>

    <record id="view_general_payroll_run_form" model="ir.ui.view">
        <field name="name">hr.payslip.run.general.payroll.form</field>
        <field name="model">hr.payslip.run</field>
        <field name="arch" type="xml">
            <form string="Nómina general" create="0" edit="0" delete="0" duplicate="0">
                <header>
                    <button name="action_print_general_payroll" type="object"
                            string="Nómina general" class="btn-primary"
                            groups="hr_payroll.group_hr_payroll_user"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="company_id" readonly="1"/>
                        <field name="date_start" readonly="1"/>
                        <field name="date_end" readonly="1"/>
                        <field name="payslip_count" readonly="1"/>
                        <field name="state" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_general_payroll_runs" model="ir.actions.act_window">
        <field name="name">Nómina general</field>
        <field name="res_model">hr.payslip.run</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_general_payroll_run_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_general_payroll_run_form')})
        ]"/>
        <field name="search_view_id" ref="hr_payroll.hr_payslip_run_filter"/>
    </record>

    <menuitem id="menu_general_payroll" name="Nómina general"
              parent="hr_payroll.menu_hr_payroll_report"
              action="action_general_payroll_runs" sequence="20"
              groups="hr_payroll.group_hr_payroll_user"/>
</odoo>
