<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_seniority_certificate" model="ir.ui.view">
        <field name="name">hr.employee.form.seniority.certificate</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_seniority_certificate" type="object"
                        string="Certificado de Antigüedad"
                        groups="hr.group_hr_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
