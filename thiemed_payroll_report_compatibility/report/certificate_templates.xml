<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="certificate_contract_dates"
              inherit_id="l10n_cl_hr_payroll_reports.report_certificado_antiguedad_document">
        <xpath expr="//t[@t-if='not o.date_end or context_timestamp(datetime.datetime.now()).date() &lt;= o.date_end']"
               position="attributes">
            <attribute name="t-if">not o.contract_date_end or ahora &lt;= o.contract_date_end</attribute>
        </xpath>
        <xpath expr="//span[@t-field='o.date_start']" position="attributes">
            <attribute name="t-field">o.contract_date_start</attribute>
        </xpath>
        <xpath expr="//span[@t-field='o.employee_id.identification_id']" position="attributes">
            <attribute name="t-field">o.identification_id</attribute>
        </xpath>
    </template>

    <template id="certificate_employee_language"
              inherit_id="l10n_cl_hr_payroll_reports.report_certificado_antiguedad">
        <xpath expr="//t[@t-set='lang']" position="attributes">
            <attribute name="t-value">o.employee_id.lang</attribute>
        </xpath>
    </template>
</odoo>
