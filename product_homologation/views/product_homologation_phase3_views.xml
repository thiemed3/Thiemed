<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_product_homologation_validation_tree" model="ir.ui.view">
        <field name="name">product.homologation.validation.tree</field>
        <field name="model">product.homologation</field>
        <field name="priority" eval="50"/>
        <field name="arch" type="xml">
            <list string="Homologaciones pendientes de validación"
                  editable="bottom"
                  multi_edit="1"
                  open_form_view="True">
                <field name="customer_code"/>
                <field name="customer_description"/>
                <field name="competitor_id" context="{'default_supplier_rank': 1}"/>
                <field name="product_id"/>
                <field name="homologation_level"/>
                <field name="precision_pct"/>
                <field name="origin_quote_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-warning="state in ('draft', 'provisional')"/>
                <button name="action_validate" type="object"
                        string="Validar" class="btn-primary"
                        invisible="state not in ('draft', 'provisional')"
                        groups="product_homologation.group_homologation_specialist"/>
                <button name="action_reject" type="object"
                        string="Rechazar" class="btn-danger"
                        invisible="state not in ('draft', 'provisional')"
                        groups="product_homologation.group_homologation_specialist"/>
            </list>
        </field>
    </record>

    <record id="action_product_homologation_validation" model="ir.actions.act_window">
        <field name="name">Validar homologaciones</field>
        <field name="res_model">product.homologation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("state", "in", ("draft", "provisional"))]</field>
        <field name="context">{'search_default_group_state': 1}</field>
        <field name="search_view_id" ref="view_product_homologation_search"/>
        <field name="view_id" ref="view_product_homologation_validation_tree"/>
    </record>

    <record id="action_product_homologation_validation_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_product_homologation_validation_tree"/>
        <field name="act_window_id" ref="action_product_homologation_validation"/>
    </record>

    <record id="action_product_homologation_validation_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_product_homologation_form"/>
        <field name="act_window_id" ref="action_product_homologation_validation"/>
    </record>

    <record id="action_product_homologation_batch_validate" model="ir.actions.server">
        <field name="name">Validar seleccionadas</field>
        <field name="model_id" ref="model_product_homologation"/>
        <field name="binding_model_id" ref="model_product_homologation"/>
        <field name="state">code</field>
        <field name="code">
            records.action_validate()
        </field>
    </record>

    <record id="action_product_homologation_batch_reject" model="ir.actions.server">
        <field name="name">Rechazar seleccionadas</field>
        <field name="model_id" ref="model_product_homologation"/>
        <field name="binding_model_id" ref="model_product_homologation"/>
        <field name="state">code</field>
        <field name="code">
            records.action_reject()
        </field>
    </record>

    <record id="action_product_homologation_import" model="ir.actions.act_window">
        <field name="name">Importar homologaciones</field>
        <field name="res_model">product.homologation.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
