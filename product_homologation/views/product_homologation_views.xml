<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_product_homologation_tree" model="ir.ui.view">
        <field name="name">product.homologation.tree</field>
        <field name="model">product.homologation</field>
        <field name="arch" type="xml">
            <list string="Homologaciones" editable="bottom" multi_edit="1" open_form_view="True">
                <field name="competitor_id" context="{'default_supplier_rank': 1}"/>
                <field name="customer_code"/>
                <field name="customer_description" optional="show"/>
                <field name="observation" optional="hide"/>
                <field name="product_id"/>
                <field name="product_default_code" optional="show"/>
                <field name="product_price" optional="hide"/>
                <field name="homologation_level" optional="show"/>
                <field name="precision_pct" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'validated'"
                       decoration-warning="state in ('draft', 'provisional')"
                       decoration-danger="state == 'rejected'"/>
                <field name="validator_id" optional="show"/>
                <field name="origin_quote_id" optional="hide"/>
                <field name="is_used" optional="hide"/>
                <button name="action_validate" type="object"
                        string="Validar" class="btn-primary"
                        invisible="state not in ('draft', 'provisional')"
                        groups="product_homologation.group_homologation_specialist"/>
                <button name="action_reject" type="object"
                        string="Rechazar" class="btn-danger"
                        invisible="state not in ('draft', 'provisional')"
                        groups="product_homologation.group_homologation_specialist"/>
            </list>
        </field>
    </record>

    <record id="view_product_homologation_form" model="ir.ui.view">
        <field name="name">product.homologation.form</field>
        <field name="model">product.homologation</field>
        <field name="arch" type="xml">
            <form string="Homologación">
                <header>
                    <button name="action_validate" type="object"
                            string="Validar" invisible="state not in ('draft', 'provisional')"
                            class="btn-primary"
                            groups="product_homologation.group_homologation_specialist"/>
                    <button name="action_reject" type="object"
                            string="Rechazar" invisible="state not in ('draft', 'provisional')"
                            class="btn-danger"
                            groups="product_homologation.group_homologation_specialist"/>
                    <button name="action_send_to_validation" type="object"
                            string="Enviar a validación" invisible="state != 'draft'"/>
                    <button name="action_draft" type="object"
                            string="Volver a borrador" invisible="state not in ('validated','rejected')"
                            groups="product_homologation.group_homologation_specialist"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,provisional,validated,rejected"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_view_quotes" type="object"
                                class="oe_stat_button" icon="fa-list"
                                invisible="not used_in_quote_count">
                            <field name="used_in_quote_count" widget="statinfo"
                                   string="Precotizaciones"/>
                        </button>
                        <button name="action_find_cross_homologations" type="object"
                                class="oe_stat_button" icon="fa-exchange"
                                invisible="not product_id">
                            <span class="o_stat_text">Homologaciones cruzadas</span>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="competitor_id" context="{'default_supplier_rank': 1}"/>
                            <field name="customer_code"/>
                            <field name="customer_description"/>
                            <field name="observation"/>
                            <field name="origin_quote_id" invisible="not origin_quote_id"/>
                            <field name="origin_quote_line_id" invisible="not origin_quote_line_id"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="product_default_code"/>
                            <field name="product_price"/>
                            <field name="homologation_level"/>
                            <field name="precision_pct"/>
                            <field name="validator_id" readonly="1"/>
                            <field name="validation_date" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="duplicates" string="Duplicados"
                              invisible="not duplicate_homologation_ids">
                            <field name="duplicate_homologation_ids" nolabel="1">
                                <list>
                                    <field name="customer_code"/>
                                    <field name="competitor_id"/>
                                    <field name="product_id"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page name="technical" string="Técnico">
                            <group>
                                <field name="normalized_description" readonly="1"/>
                                <field name="is_provisional" readonly="1"/>
                                <field name="is_used" readonly="1"/>
                                <field name="used_in_sale_count" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_product_homologation_possible_tree" model="ir.ui.view">
        <field name="name">product.homologation.possible.tree</field>
        <field name="model">product.homologation</field>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <list string="Alternativas de homologación" create="0" edit="0" delete="0">
                <button name="action_apply_to_quote_line" type="object"
                        string="Seleccionar" class="btn-primary"/>
                <field name="competitor_id"/>
                <field name="customer_code"/>
                <field name="customer_description"/>
                <field name="product_id"/>
                <field name="product_default_code"/>
                <field name="product_price" string="Precio"/>
                <field name="homologation_level"/>
                <field name="precision_pct"/>
                <field name="observation" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'validated'"
                       decoration-warning="state == 'provisional'"/>
            </list>
        </field>
    </record>

    <record id="view_product_homologation_possible_form" model="ir.ui.view">
        <field name="name">product.homologation.possible.form</field>
        <field name="model">product.homologation</field>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <form string="Alternativa de homologación" create="0" edit="0" delete="0">
                <header>
                    <button name="action_apply_to_quote_line" type="object"
                            string="Seleccionar" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="competitor_id"/>
                            <field name="customer_code"/>
                            <field name="customer_description"/>
                            <field name="observation"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="product_default_code"/>
                            <field name="product_price"/>
                            <field name="homologation_level"/>
                            <field name="precision_pct"/>
                            <field name="state"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_homologation_search" model="ir.ui.view">
        <field name="name">product.homologation.search</field>
        <field name="model">product.homologation</field>
        <field name="arch" type="xml">
            <search>
                <field name="customer_code"/>
                <field name="customer_description"/>
                <field name="product_id"/>
                <field name="competitor_id"/>
                <filter name="state_draft" string="Borrador"
                        domain="[('state','=','draft')]"/>
                <filter name="state_provisional" string="Provisional"
                        domain="[('state','=','provisional')]"/>
                <filter name="state_validated" string="Validado"
                        domain="[('state','=','validated')]"/>
                <filter name="state_rejected" string="Rechazado"
                        domain="[('state','=','rejected')]"/>
                <separator/>
                <group>
                    <filter name="group_state" string="Estado"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_competitor" string="Por competidor"
                            context="{'group_by': 'competitor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_product_homologation" model="ir.actions.act_window">
        <field name="name">Homologaciones</field>
        <field name="res_model">product.homologation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_product_homologation_search"/>
    </record>

    <record id="action_product_homologation_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_product_homologation_tree"/>
        <field name="act_window_id" ref="action_product_homologation"/>
    </record>

    <record id="action_product_homologation_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_product_homologation_form"/>
        <field name="act_window_id" ref="action_product_homologation"/>
    </record>
</odoo>
