<?xml version="1.0" encoding="ISO-8859-1"?>
<odoo>
    <data>
        <template id="dte_subtemplate" inherit_id="l10n_cl_edi_stock.dte_subtemplate">
            <xpath expr="//t[@t-if='picking.l10n_cl_reference_ids']" position="replace">
                <t t-if="picking.sale_id.client_order_ref or picking.l10n_cl_reference_ids">
                    <t t-set="reference_number" t-value="1"/>

                    <!--Comprobar si la OC ya existe como referencia tributaria 801-->
                    <t t-set="sale_oc"
                    t-value="(picking.sale_id.client_order_ref or '').strip()"/>

                    <t t-set="existing_oc_refs"
                       t-value="picking.l10n_cl_reference_ids.filtered(
                            lambda ref: ref.l10n_cl_reference_doc_type_id.code == '801'
                            and (ref.origin_doc_number or '').strip() == sale_oc
                        )"/>
                    <t t-if="sale_oc and not existing_oc_refs">
                    <Referencia>
                            <NroLinRef t-out="reference_number"/>
                            <TpoDocRef t-out="'801'"/>
                            <FolioRef t-out="picking.sale_id.client_order_ref"/>
                            <FchRef t-out="picking.sale_id.date_dte or picking.sale_id.date_order.date()"/>
                            <RazonRef t-out="'Orden de compra Ref Cliente'"/>
                    </Referencia>
                        <t t-set="reference_number" t-value="reference_number + 1"/>
                    </t>
                    <t t-foreach="picking.l10n_cl_reference_ids" t-as="reference_id">
                    <Referencia>
                            <NroLinRef t-out="reference_number"/>
                            <TpoDocRef t-out="reference_id.l10n_cl_reference_doc_type_id.code"/>
                            <FolioRef t-out="reference_id.origin_doc_number[:18]"/>
                            <FchRef t-if="not picking.l10n_latam_document_type_id._is_doc_type_voucher()" t-out="reference_id.date"/>
                            <CodRef t-out="reference_id.reference_doc_code"/>
                            <RazonRef t-if="reference_id.reason" t-out="reference_id.reason[:90]"/>
                    </Referencia>
                    <t t-set="reference_number" t-value="reference_number + 1"/>
                    </t>
                </t>
            </xpath>
        </template>
    </data>
</odoo>
